<grouop name="modsecurity,">
    
    <rule id="100000" level="0">
        <decoded_as>nginx-errorlog-modsec</decoded_as>
        <description>ModSecurity event terdeteksi - rule $(rule_id): $(message)</description>
    </rule>

    <rule id="100001" level="3">
        <if_sid>100000</if_sid>
        <field name="severity">^5$</field>
        <description>ModSecurity NOTICE (rule $(rule_id)): $(message)</description>
    </rule>

    <rule id="100002" level="5">
        <if_sid>31301</if_sid>
        <match>access forbidden by rule</match>
        <description>Nginx Error: Forbidden by Rules</description>
        <group>nginx_error,</group>
    </rule>

    <rule id="100003" level="10" frequency="10" timeframe="30">
        <if_matched_sid>100002</if_matched_sid>
        <same_srcip />
        <description>Multiple: Nginx error forbidden by rules.</description>
        <mitre>
	        <id>T1595.003</id>
        </mitre>
        <group>nginx_error,recon,</group>
    </rule>

    <rule id="100004" level="12">
        <if_sid>100000</if_sid>
        <field name="severity">^2$</field>
        <description>ModSecurity CRITICAL (rule $(rule_id)): $(message)</description>
        <mitre>
            <id>T1190</id>
        </mitre>
        <group>modsec_critical,</group>
    </rule>

    <rule id="100005" level="9">
        <if_sid>100000</if_sid>
        <field name="severity">^3$</field>
        <description>ModSecurity ERROR (rule $(rule_id)): $(message)</description>
        <group>modsec_error,</group>
    </rule>

    <rule id="100006" level="6">
        <if_sid>100000</if_sid>
        <field name="severity">^4$</field>
        <description>ModSecurity WARNING (rule $(rule_id)): $(message)</description>
        <group>modsec_warning,</group>
    </rule>

    <rule id="100007" level="14" timeframe="30" frequency="10">
        <if_matched_sid>100004</if_matched_sid>
        <same_srcip />
        <description>Multiple: ModSecurity CRITICAL (rule $(rule_id)): $(message)</description>
        <mitre>
            <id>T1190</id>
        </mitre>
        <group>modsec_critical,</group>
    </rule>

    <rule id="100008" level="14" timeframe="30" frequency="10">
        <if_matched_sid>100005</if_matched_sid>
        <same_srcip />
        <description>Multiple: ModSecurity ERROR (rule $(rule_id)): $(message)</description>
        <group>modsec_error,</group>
    </rule>
</group>